# ============================================================
# Python .gitignore  (paper repo template)
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual envs (HUGELY important — do NOT push 10GB venvs!) ---
.venv/
venv/
ENV/
env/
smpl_env/
smpl_env311/
smplify-x/
.conda/

# --- IDEs ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- LaTeX / papers auxiliary ---
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

# ============================================================
# Datasets — AGORA is 10 GB+ and AGORA's licence forbids redistribution
# ============================================================
data/
dataset/
*.pkl
*.pickle

# ============================================================
# Model weights — must be requested from MPI / smpl-x website individually
# ============================================================
models/
*.pt
*.pth
*.npz
*.ckpt

# ============================================================
# Outputs (regenerated by running the scripts)
# ============================================================
output*/
backup_*/
*.png
!paper_vc/figures/*.png
!paper_jg/figures/*.png
!src/**/*.png

# ============================================================
# Logs and terminals
# ============================================================
terminals/
terminal_*.txt
*.log
